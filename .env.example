# ==============================================================================
# EstatePilot AI — Environment Configuration Example (.env.example)
# ==============================================================================
# Instructions:
# 1. Copy this file to .env.local for local development.
# 2. Never commit real credentials or .env.local to version control.
# ==============================================================================

# Application Environment & URLs
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="EstatePilot AI"
NEXT_PUBLIC_APP_TAGLINE="Your AI-Powered Real Estate Business Operating System"

# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------
# Public Supabase URL (safe for client-side usage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public Supabase Anon Key (safe for client-side usage with RLS enabled)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Key (STRICTLY SERVER-SIDE - NEVER EXPOSE TO CLIENT)
# Used only by background workers, migrations, and super-admin scripts
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Database Direct & Pooled URLs (for Prisma, Drizzle, or direct migrations)
DATABASE_URL=postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:5432/postgres

# ------------------------------------------------------------------------------
# Security & Secret Encryption
# ------------------------------------------------------------------------------
# 32-byte hexadecimal key for encrypting third-party tokens (AES-256-GCM)
# Generate with: openssl rand -hex 32
INTEGRATION_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# JWT Secret for session signing verification
AUTH_JWT_SECRET=your-32-character-random-secret-key-here

# ------------------------------------------------------------------------------
# AI Provider Credentials (Central AI Orchestrator)
# ------------------------------------------------------------------------------
# OpenAI API Key (GPT-4o, GPT-4o-mini, Embeddings)
OPENAI_API_KEY=sk-proj-your-openai-api-key

# Google Gemini API Key (Gemini 1.5 Pro, Gemini 1.5 Flash)
GEMINI_API_KEY=AIzaSyYourGeminiApiKey

# Anthropic Claude API Key (Claude 3.5 Sonnet, Claude 3.5 Haiku)
ANTHROPIC_API_KEY=sk-ant-api03-your-anthropic-key

# Default AI Model Provider (openai | gemini | anthropic)
DEFAULT_AI_PROVIDER=openai

# ------------------------------------------------------------------------------
# Voice AI Integration (Vapi / ElevenLabs)
# ------------------------------------------------------------------------------
VAPI_API_KEY=your-vapi-api-key
VAPI_ASSISTANT_ID=your-vapi-assistant-id
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# ------------------------------------------------------------------------------
# Messaging & Communication Integrations
# ------------------------------------------------------------------------------
# WhatsApp Cloud API (Meta for Developers)
WHATSAPP_API_TOKEN=your-whatsapp-cloud-api-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-business-account-id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-custom-webhook-verify-token
WHATSAPP_APP_SECRET=your-meta-app-secret

# Google Workspace / Gmail & Google Calendar Integration
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# Twilio SMS Provider
TWILIO_ACCOUNT_SID=ACyour-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ------------------------------------------------------------------------------
# Billing & Subscriptions (Stripe & Razorpay)
# ------------------------------------------------------------------------------
# Stripe
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key

# Razorpay (for Indian and Global Multi-Currency Support)
RAZORPAY_KEY_ID=rzp_test_your-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# ------------------------------------------------------------------------------
# Maps & Geocoding
# ------------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyYourGoogleMapsApiKey

# ------------------------------------------------------------------------------
# Observability & Error Tracking
# ------------------------------------------------------------------------------
SENTRY_DSN=https://your-sentry-dsn@o0.ingest.sentry.io/0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
