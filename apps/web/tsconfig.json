{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "es5",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@estatepilot/shared": ["../../packages/shared/src/index.ts"],
      "@estatepilot/shared/*": ["../../packages/shared/src/*"],
      "@estatepilot/validation": ["../../packages/validation/src/index.ts"],
      "@estatepilot/validation/*": ["../../packages/validation/src/*"],
      "@estatepilot/permissions": ["../../packages/permissions/src/index.ts"],
      "@estatepilot/permissions/*": ["../../packages/permissions/src/*"],
      "@estatepilot/database": ["../../packages/database/src/index.ts"],
      "@estatepilot/database/*": ["../../packages/database/src/*"],
      "@estatepilot/auth": ["../../packages/auth/src/index.ts"],
      "@estatepilot/auth/*": ["../../packages/auth/src/*"],
      "@estatepilot/ai-runtime": ["../../packages/ai-runtime/src/index.ts"],
      "@estatepilot/ai-runtime/*": ["../../packages/ai-runtime/src/*"],
      "@estatepilot/agent-registry": ["../../packages/agent-registry/src/index.ts"],
      "@estatepilot/agent-registry/*": ["../../packages/agent-registry/src/*"],
      "@estatepilot/billing": ["../../packages/billing/src/index.ts"],
      "@estatepilot/billing/*": ["../../packages/billing/src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
